<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MissionControl.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core on in-memory SQLite: real SQL (so EF spans show up in traces) with zero persistence. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- IChatClient + the OpenTelemetry chat wrapper that emits gen_ai.* spans and token metrics. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionControl.ServiceDefaults\MissionControl.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
